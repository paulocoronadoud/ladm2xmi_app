<ch.ehi.basics.types.NlsString TID="2184">
<Entry TID="2185" language="es" translation="Se considerar&#225; como procedimientos catastrales con efectos registrales los siguientes: actualizaci&#243;n de linderos, rectificaci&#243;n de &#225;rea por imprecisa determinaci&#243;n, actualizaci&#243;n masiva y puntual de linderos y &#225;reas, rectificaci&#243;n de linderos por acuerdo entre las partes, e inclusi&#243;n de &#225;rea y/o linderos."/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="1141">
</ch.ehi.basics.types.NlsString>
