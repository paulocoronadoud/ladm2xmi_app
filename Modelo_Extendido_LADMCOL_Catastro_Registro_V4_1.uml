<ch.ehi.basics.types.NlsString TID="9832">
<Entry TID="9833" language="es" translation="Se califica con destino Salubridad, aquellos predios destinados al cuidado de la salud de los ciudadanos, incluye los hospitales, centros de salud, cl&#237;nicas, laboratorios y consultorios que prestan el servicio de salud tanto de car&#225;cter p&#250;blico o privado.&#10;"/>
</ch.ehi.basics.types.NlsString>
