<ch.ehi.basics.types.NlsString TID="9656">
<Entry TID="9668" language="es" translation="Hace referencia al estado del FMI al que no es posible hacerle anotaciones de negocios jur&#237;dicos, porque el &#225;rea que identifica pasa a formar parte de un predio identificado con un folio diferente, ya sea por un englobe o por su total divisi&#243;n o por decisi&#243;n administrativa o judicial, por lo cual se cierra el FMI ante la inexistencia de &#225;rea remanente. &#10;"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="9665">
<Entry TID="9669" language="es" translation="FMI que cambia de Oficina de Registro, pasa a denominarse &#8220;matr&#237;cula origen&#8221;, se genera un nuevo FMI en la nueva Oficina de Registro de Instrumentos P&#250;blicos que se denomina &#8220;matr&#237;cula destino&#8221;.&#10;"/>
</ch.ehi.basics.types.NlsString>
