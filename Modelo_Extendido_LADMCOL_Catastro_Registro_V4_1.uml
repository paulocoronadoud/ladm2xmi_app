</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="9845">
<Entry TID="9938" language="es" translation="EnumElement107"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="9928">
