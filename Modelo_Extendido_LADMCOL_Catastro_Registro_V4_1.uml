</ch.ehi.interlis.domainsandconstants.basetypes.EnumElement>
<ch.ehi.basics.types.NlsString TID="7979">
<Entry TID="7981" language="es" translation="EnumElement11018"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="7969">
<Entry TID="7982" language="es" translation="Un acto administrativo es toda manifestaci&#243;n o declaraci&#243;n emanada de la administraci&#243;n p&#250;blica en el ejercicio de potestades administrativas.&#10;"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="7978">
<Entry TID="7983" language="es" translation="Escritura_Publica"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="7980">
<Entry TID="7984" language="es" translation="Una escritura p&#250;blica es un documento p&#250;blico en el que se realiza ante un notario p&#250;blico un determinado hecho o un derecho autorizado por dicho fedatario p&#250;blico, que firma con el otorgante u otorgantes,mostrando sobre la capacidad jur&#237;dica del contenido y de la fecha en que se realiz&#243;&#10;"/>
</ch.ehi.basics.types.NlsString>
