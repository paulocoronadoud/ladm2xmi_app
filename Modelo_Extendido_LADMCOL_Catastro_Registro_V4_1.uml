<ch.ehi.basics.types.NlsString TID="6953">
<Entry TID="6955" language="es" translation="Dep&#243;sito de agua construido a nivel del terreno con el prop&#243;sito de almacenar agua, o en el caso de las ba&#241;aderas con el fin de hacer limpieza al ganado, estas construcciones son cubiertas para guardar de la intemperie.&#10;"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="6951">
<Entry TID="6956" language="es" translation="Albercas_Banaderas"/>
