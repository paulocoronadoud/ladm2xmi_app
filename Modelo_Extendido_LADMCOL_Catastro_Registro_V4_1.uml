<ch.ehi.basics.types.NlsString TID="1311">
<Entry TID="2186" language="es" translation="Es un consecutivo asignado autom&#225;ticamente en registro en lugar del n&#250;mero de la identificaci&#243;n de la persona que hace el tr&#225;mite, se usa especialmente en tr&#225;mites de construcci&#243;n cuando el proyecto est&#225; a nombre de una Fiducia el cual tiene el mismo n&#250;mero del banco. &#10;"/>
</ch.ehi.basics.types.NlsString>
