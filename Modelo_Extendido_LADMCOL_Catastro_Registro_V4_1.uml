<Enumeration>9748</Enumeration>
<NameList>9928</NameList>
<Documentation>9929</Documentation>
<DefLangName>Infraestructura_Saneamiento_Basico</DefLangName>
</ch.ehi.interlis.domainsandconstants.basetypes.EnumElement>
<ch.ehi.basics.types.NlsString TID="9929">
<Entry TID="9930" language="es" translation="Se califica con destino Infraestructura de Saneamiento B&#225;sico, aquellos predios sobre los cuales se encuentra establecida la infraestructura para el saneamiento b&#225;sico. Incluye los centros de acopio de basura y material reciclable, rellenos sanitarios e incineradoras, alcantarillados y las estaciones depuradoras de aguas residuales.&#10;"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="9927">
<Entry TID="9931" language="es" translation="Infraestructura_Saneamiento_Basico"/>
</ch.ehi.basics.types.NlsString>
