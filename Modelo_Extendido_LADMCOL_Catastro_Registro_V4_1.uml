</ch.ehi.interlis.domainsandconstants.basetypes.EnumElement>
<ch.ehi.basics.types.NlsString TID="9840">
<Entry TID="9841" language="es" translation="Se califica con destino recreacional, aquellos predios que corresponden a equipamientos deportivos y recreativos, parques de propiedad privada o p&#250;blica, clubes, generando bienestar f&#237;sico y social.&#10;"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="9804">
<Entry TID="9842" language="es" translation="Se califica con destino Lote Urbanizable no Urbanizado, aquellos predios urbanos no construidos o construidos que predominantemente no ejecutan ninguna actividad econ&#243;mica, que no han sido desarrollados y sin restricci&#243;n legal para adelantar alg&#250;n tipo de proyecto.&#10;"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="9795">
<Entry TID="9843" language="es" translation="Acuicola"/>
</ch.ehi.basics.types.NlsString>
