</ch.ehi.interlis.domainsandconstants.basetypes.EnumElement>
<ch.ehi.basics.types.NlsString TID="7967">
<Entry TID="7970" language="es" translation="Acto_Administrativo"/>
</ch.ehi.basics.types.NlsString>
