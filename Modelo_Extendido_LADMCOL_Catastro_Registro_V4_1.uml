<ch.ehi.basics.types.NlsString TID="6940">
<Entry TID="6943" language="es" translation="Nombre dado en zonas cafeteras a aquellas construcciones donde realizan el beneficio del caf&#233;. Consiste en &#225;reas cubiertas dentro de las cuales se encuentran los elementos destinados a la labor de seleccionar, lavar y despulpar el grano y su posterior empaque.&#10;"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="6860">
<Entry TID="6944" language="es" translation="Kioscos"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="6878">
<Entry TID="6945" language="es" translation="Estanque artificial con destino al deporte o a la recreaci&#243;n. Se diferencia por sus acabados y especificaciones t&#233;cnicas para su mantenimiento y operaci&#243;n; sus dimensiones deben darse en unidades de &#225;rea (m2).&#10;"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="6864">
<Entry TID="6946" language="es" translation="Cimientos_Estructura_Muros_y_Placa_Base"/>
</ch.ehi.basics.types.NlsString>
