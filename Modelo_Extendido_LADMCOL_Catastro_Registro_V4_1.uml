<ch.ehi.basics.types.NlsString TID="1503">
<Entry TID="1505" language="es" translation="Folio destinado a la inscripci&#243;n de los actos, contratos y providencias relacionados en el art&#237;culo 4&#176; de la Ley 1579 de 2012 &#8220;Por la cual se expide el estatuto de registro de instrumentos p&#250;blicos y se dictan otras disposiciones&#8221;, referente a un bien ra&#237;z, el cual se distinguir&#225; con un c&#243;digo alfanum&#233;rico o complejo numeral indicativo del orden interno de cada oficina de registro y de la sucesi&#243;n en que se vaya sentando. &#10;"/>
</ch.ehi.basics.types.NlsString>
