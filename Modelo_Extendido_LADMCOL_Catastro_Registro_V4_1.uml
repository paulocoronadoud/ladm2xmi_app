<Entry TID="2993" language="es" translation="Sexo"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="2992">
<Entry TID="2994" language="es" translation="Corresponde a &#8220;Masculino&#8221;, &#8220;Femenino&#8221;, &#8220;No Binario&#8221; o &quot;Sin determinar&quot; seg&#250;n como aparezca en el documento de identidad. No aplica este tipo de identificaci&#243;n para personas jur&#237;dicas.&#10;"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="2969">
<Entry TID="2995" language="es" translation="Para el desarrollo de la gesti&#243;n catastral es la persona que frente a un inmueble ostenta la relaci&#243;n jur&#237;dica de propietario, poseedor u ocupante.&#10;"/>
</ch.ehi.basics.types.NlsString>
