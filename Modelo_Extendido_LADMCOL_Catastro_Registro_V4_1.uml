<ch.ehi.basics.types.NlsString TID="9807">
<Entry TID="9941" language="es" translation="Se califica con destino Cultural, aquellos predios considerados como bienes culturales de la naci&#243;n, adem&#225;s los espacios destinados al desarrollo de actividades art&#237;sticas.&#10;"/>
</ch.ehi.basics.types.NlsString>
