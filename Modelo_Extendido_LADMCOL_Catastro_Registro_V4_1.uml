</ch.ehi.interlis.domainsandconstants.basetypes.EnumElement>
<ch.ehi.basics.types.NlsString TID="9911">
<Entry TID="9912" language="es" translation="Se califica con destino pecuario, aquellos predios destinados a la cr&#237;a, beneficio y aprovechamiento de especies de animales no dom&#233;sticos, para el consumo humano (productos c&#225;rnicos y l&#225;cteos), uso artesanal (lana, cuero, plumas, etc.) y conservaci&#243;n de fauna (zoocr&#237;a).&#10;"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="9909">
<Entry TID="9913" language="es" translation="Pecuario"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="9831">
