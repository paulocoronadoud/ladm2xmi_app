<Enumeration>7960</Enumeration>
<NameList>7974</NameList>
<Documentation>7975</Documentation>
<DefLangName>Sentencia_Judicial</DefLangName>
</ch.ehi.interlis.domainsandconstants.basetypes.EnumElement>
<ch.ehi.basics.types.NlsString TID="7974">
<Entry TID="7976" language="es" translation="EnumElement11019"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="7975">
<Entry TID="7977" language="es" translation="La sentencia es la resoluci&#243;n judicial definitiva dictada por un juez o tribunal que pone fin a la litis o caso sometido a su conocimiento y cierra definitivamente su actuaci&#243;n en el mismo.&#10;"/>
</ch.ehi.basics.types.NlsString>
