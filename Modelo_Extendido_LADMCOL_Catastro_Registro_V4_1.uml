<Enumeration>9748</Enumeration>
<NameList>9922</NameList>
<Documentation>9923</Documentation>
<DefLangName>Lote_Rural</DefLangName>
</ch.ehi.interlis.domainsandconstants.basetypes.EnumElement>
<ch.ehi.basics.types.NlsString TID="9923">
<Entry TID="9924" language="es" translation="Se califica con destino Lote Rural, aquellos predios rurales no construidos que no desarrollan ninguna actividad econ&#243;mica.&#10;"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="9922">
