</ch.ehi.basics.types.NlsString>
<ch.ehi.interlis.domainsandconstants.basetypes.EnumElement TID="9782">
<Name>9915</Name>
<Enumeration>9748</Enumeration>
<NameList>9916</NameList>
<Documentation>9917</Documentation>
<DefLangName>Uso_Publico</DefLangName>
</ch.ehi.interlis.domainsandconstants.basetypes.EnumElement>
<ch.ehi.basics.types.NlsString TID="9917">
<Entry TID="9918" language="es" translation="Se califica con destino Uso P&#250;blico, Aquellos predios destinados al uso y goce de todos los habitantes del territorio, como las zonas verdes, alamedas, plazas (no se incluyen las plazas de mercado), plazoletas parques, cuerpos de agua, &#225;reas de control, t&#250;neles, v&#237;as, ciclorutas, glorietas entre otros.&#10;"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="9915">
<Entry TID="9919" language="es" translation="Uso_Publico"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="9916">
<Entry TID="9920" language="es" translation="EnumElement102"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.interlis.domainsandconstants.basetypes.EnumElement TID="9775">
