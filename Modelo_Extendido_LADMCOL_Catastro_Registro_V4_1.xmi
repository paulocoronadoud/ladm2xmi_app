            <ownedComment xmi:type="uml:Comment" xmi:id="id_g518" annotatedElement="id_628">
              <body>Comentario incluido en algunas anotaciones en el folio de matrícula inmobiliaria, donde se amplía la información del acto objeto de registro.</body>
            </ownedComment>
            <ownedComment xmi:type="uml:Comment" xmi:id="id_g519" annotatedElement="id_628">
              <body>[INTERLIS] Tipo Texto de longitud máxima 200</body>
            </ownedComment>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="id_629" name="Fecha_Anotacion" type="id_g448">
