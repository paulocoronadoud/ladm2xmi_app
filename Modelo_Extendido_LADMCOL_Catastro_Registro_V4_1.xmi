            </ownedComment>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="id_627" name="Codigo_Naturaleza_Juridica" type="id_g7">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_g512" value="0" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_g513" value="1" />
            <ownedComment xmi:type="uml:Comment" xmi:id="id_g514" annotatedElement="id_627">
              <body>Código asignado de acuerdo a la naturaleza jurídica de cada uno de los actos sometidos a registro, así: tradición, gravámenes, limitaciones y afectaciones, medidas cautelares, tenencia, falsa tradición, cancelaciones y otros.</body>
            </ownedComment>
            <ownedComment xmi:type="uml:Comment" xmi:id="id_g515" annotatedElement="id_627">
              <body>[INTERLIS] Tipo Texto de longitud máxima 5</body>
            </ownedComment>
