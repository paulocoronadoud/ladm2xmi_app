            <ownedComment xmi:type="uml:Comment" xmi:id="id_g648" annotatedElement="id_2977">
              <body>Todo habitante de zonas rurales tiene la opción de autoreconocerse como campesino en función del artículo 64 de la Constitución Política.</body>
            </ownedComment>
          </ownedAttribute>
