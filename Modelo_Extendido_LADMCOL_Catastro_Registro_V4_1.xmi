            <ownedComment xmi:type="uml:Comment" xmi:id="id_g138" annotatedElement="id_2956">
              <body>Tipo de eje vial.</body>
            </ownedComment>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="id_2957" name="Numero_Via" type="id_g7">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_g139" value="1" />
