        <packagedElement xmi:type="uml:Class" xmi:id="id_1324" name="CR_AnotacionRegistro">
          <ownedComment xmi:type="uml:Comment" xmi:id="id_g784" annotatedElement="id_1324">
            <body>Es la culminación de trámite registral, luego de efectuada la inscripción y puesta la constancia de ella en el título o documento objeto de registro.</body>
          </ownedComment>
          <ownedAttribute xmi:type="uml:Property" xmi:id="id_1439" name="Numero_Radicacion" type="id_g7">
