        <packagedElement xmi:type="uml:Class" xmi:id="id_1142" name="CC_Corregimiento">
          <ownedComment xmi:type="uml:Comment" xmi:id="id_g111" annotatedElement="id_1142">
            <body>Es una división del departamento, al tenor del Decreto 2274 del 4 de octubre de 1991, la cual incluye un núcleo de población. Según esta misma disposición, los ahora corregimientos departamentales no forman parte de un determinado municipio.</body>
          </ownedComment>
          <ownedAttribute xmi:type="uml:Property" xmi:id="id_1148" name="Codigo" type="id_g7">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_g112" value="1" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_g113" value="1" />
            <ownedComment xmi:type="uml:Comment" xmi:id="id_g114" annotatedElement="id_1148">
              <body>Código de identificación del corregimiento.</body>
            </ownedComment>
            <ownedComment xmi:type="uml:Comment" xmi:id="id_g115" annotatedElement="id_1148">
              <body>[INTERLIS] Tipo Texto de longitud máxima 5</body>
            </ownedComment>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="id_1149" name="Nombre" type="id_g7">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_g116" value="1" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_g117" value="1" />
            <ownedComment xmi:type="uml:Comment" xmi:id="id_g118" annotatedElement="id_1149">
              <body>Nombre del corregimiento.</body>
            </ownedComment>
            <ownedComment xmi:type="uml:Comment" xmi:id="id_g119" annotatedElement="id_1149">
              <body>[INTERLIS] Tipo Texto de longitud máxima 50</body>
            </ownedComment>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="id_1150" name="Geometria" type="id_1017">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_g120" value="1" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_g121" value="1" />
            <ownedComment xmi:type="uml:Comment" xmi:id="id_g122" annotatedElement="id_1150">
              <body>Tipo de geometría y su representación georrefenciada que definen los límites y el área ocupada por el corregimiento.</body>
            </ownedComment>
          </ownedAttribute>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="id_538" name="CC_CentroPoblado">
          <ownedComment xmi:type="uml:Comment" xmi:id="id_g123" annotatedElement="id_538">
            <body>Son los asentamientos rurales nucleados, con vivienda concentrada, que albergan servicios públicos, sociales, asistenciales, administrativos, recreativos y culturales, y que atienden la población dispersa de las veredas en su área de influencia.</body>
          </ownedComment>
          <ownedAttribute xmi:type="uml:Property" xmi:id="id_1555" name="Codigo" type="id_g7">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_g124" value="1" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_g125" value="1" />
            <ownedComment xmi:type="uml:Comment" xmi:id="id_g126" annotatedElement="id_1555">
              <body>Código de identificación del centro poblado.</body>
            </ownedComment>
            <ownedComment xmi:type="uml:Comment" xmi:id="id_g127" annotatedElement="id_1555">
              <body>[INTERLIS] Tipo Texto de longitud máxima 7</body>
            </ownedComment>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="id_1556" name="Nombre" type="id_g7">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_g128" value="1" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_g129" value="1" />
            <ownedComment xmi:type="uml:Comment" xmi:id="id_g130" annotatedElement="id_1556">
              <body>Nombre del centro poblado.</body>
            </ownedComment>
            <ownedComment xmi:type="uml:Comment" xmi:id="id_g131" annotatedElement="id_1556">
              <body>[INTERLIS] Tipo Texto de longitud máxima 50</body>
            </ownedComment>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="id_1557" name="Geometria" type="id_1017">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_g132" value="1" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_g133" value="1" />
            <ownedComment xmi:type="uml:Comment" xmi:id="id_g134" annotatedElement="id_1557">
              <body>Tipo de geometría y su representación georrefenciada que definen los límites y el área ocupada por el centro poblado.</body>
            </ownedComment>
          </ownedAttribute>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="id_836" name="CC_NomenclaturaVial">
          <ownedComment xmi:type="uml:Comment" xmi:id="id_g135" annotatedElement="id_836">
            <body>La Nomenclatura Vial es el conjunto de caracteres alfanuméricos que se emplean para identificar una vía espacialmente.</body>
          </ownedComment>
          <ownedAttribute xmi:type="uml:Property" xmi:id="id_2956" name="Tipo_Via" type="id_e7210">
