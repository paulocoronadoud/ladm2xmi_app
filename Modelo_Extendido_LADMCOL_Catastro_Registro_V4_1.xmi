            <ownedComment xmi:type="uml:Comment" xmi:id="id_g693" annotatedElement="id_4704">
              <body>Valor más probable por el cual se transaría el terreno en el mercado.</body>
            </ownedComment>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="id_4705" name="Avaluo_Catastral_Terreno" type="id_3441">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_g694" value="0" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_g695" value="1" />
            <ownedComment xmi:type="uml:Comment" xmi:id="id_g696" annotatedElement="id_4705">
              <body>Avalúo catastral del terreno.</body>
            </ownedComment>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="id_4706" name="Valor_Comercial_Total_UnidadesConstruccion" type="id_3441">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_g697" value="0" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_g698" value="1" />
            <ownedComment xmi:type="uml:Comment" xmi:id="id_g699" annotatedElement="id_4706">
