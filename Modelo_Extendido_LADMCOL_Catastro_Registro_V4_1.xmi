            </ownedComment>
            <ownedComment xmi:type="uml:Comment" xmi:id="id_g674" annotatedElement="id_2696">
              <body>[INTERLIS] Tipo Texto de longitud máxima 20</body>
            </ownedComment>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="id_2697" name="Matricula_Inmobiliaria" type="id_g7">
