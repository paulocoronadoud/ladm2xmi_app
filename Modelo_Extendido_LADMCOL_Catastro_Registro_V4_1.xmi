            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_g1360" value="*" />
          </ownedAttribute>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="id_2028" name="CR_Terreno">
          <ownedComment xmi:type="uml:Comment" xmi:id="id_g461" annotatedElement="id_2028">
            <body>Extensión geográfica espacial del predio</body>
          </ownedComment>
          <ownedAttribute xmi:type="uml:Property" xmi:id="id_7126" name="Geometria" type="id_1017">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_g462" value="1" />
