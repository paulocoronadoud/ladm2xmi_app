            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_g641" value="1" />
            <ownedComment xmi:type="uml:Comment" xmi:id="id_g642" annotatedElement="id_2975">
              <body>Corresponde a “Masculino”, “Femenino”, “No Binario” o "Sin determinar" según como aparezca en el documento de identidad. No aplica este tipo de identificación para personas jurídicas.</body>
            </ownedComment>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="id_2976" name="AutoreconocimientoEtnico" type="id_176">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_g643" value="0" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_g644" value="1" />
            <ownedComment xmi:type="uml:Comment" xmi:id="id_g645" annotatedElement="id_2976">
              <body>"Según la Corte Constitucional (sentencia T-445-22), las personas tienen el derecho a auto reconocerse como pertenecientes a cualquier etnia si subjetivamente considera que tiene los vínculos culturales, familiares o históricos.

En este sentido, la persona puede auto reconocerse como indígena, gitano Romaní, raizal, palenquero, negro o afrocolombiano"</body>
            </ownedComment>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="id_2977" name="AutoreconocimientoCampesino" type="id_g477">
