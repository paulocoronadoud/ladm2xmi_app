        <packagedElement xmi:type="uml:DataType" xmi:id="id_2467" name="CR_EstructuraMatriculaSegregados">
          <ownedComment xmi:type="uml:Comment" xmi:id="id_g659" annotatedElement="id_2467">
            <body>Corresponde a la información del código de la ORIP y el número de matrícula inmobiliaria de los predios que se han aperturado con base en el predio objeto de estudio.</body>
          </ownedComment>
          <ownedComment xmi:type="uml:Comment" xmi:id="id_g660" annotatedElement="id_2467">
            <body>[INTERLIS] STRUCTURE</body>
          </ownedComment>
          <ownedAttribute xmi:type="uml:Property" xmi:id="id_3066" name="Codigo_ORIP" type="id_g7">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_g661" value="0" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_g662" value="1" />
            <ownedComment xmi:type="uml:Comment" xmi:id="id_g663" annotatedElement="id_3066">
              <body>Número asignado a cada oficina de registro de acuerdo a su comprensión registral.</body>
            </ownedComment>
            <ownedComment xmi:type="uml:Comment" xmi:id="id_g664" annotatedElement="id_3066">
              <body>[INTERLIS] Tipo Texto de longitud máxima 20</body>
            </ownedComment>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="id_3067" name="Matricula_Inmobiliaria" type="id_g7">
