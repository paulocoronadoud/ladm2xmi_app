            <ownedComment xmi:type="uml:Comment" xmi:id="id_g464" annotatedElement="id_7126">
              <body>Corresponde a la figura geométrica vectorial poligonal.</body>
            </ownedComment>
          </ownedAttribute>
          <generalization xmi:type="uml:Generalization" xmi:id="id_1068" general="id_477" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="id_959" name="CR_Responsabilidad">
          <ownedComment xmi:type="uml:Comment" xmi:id="id_g465" annotatedElement="id_959">
            <body>Obligación de hacer algo relacionado con el predio.</body>
          </ownedComment>
          <ownedAttribute xmi:type="uml:Property" xmi:id="id_4797" name="Tipo" type="id_2007">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_g466" value="1" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_g467" value="1" />
            <ownedComment xmi:type="uml:Comment" xmi:id="id_g468" annotatedElement="id_4797">
              <body>Tipos que se desarrollan por el origen de la responsabilidad.</body>
            </ownedComment>
          </ownedAttribute>
          <generalization xmi:type="uml:Generalization" xmi:id="id_547" general="id_1805" />
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="id_2851" name="CR_PuntoLindero">
          <ownedComment xmi:type="uml:Comment" xmi:id="id_g469" annotatedElement="id_2851">
            <body>Punto que define la frontera de un predio con otro. La sucesión de estos puntos forma una línea que representa el límite entre dos terrenos.</body>
          </ownedComment>
          <ownedAttribute xmi:type="uml:Property" xmi:id="id_2860" name="ID_Punto_Lindero" type="id_g7">
