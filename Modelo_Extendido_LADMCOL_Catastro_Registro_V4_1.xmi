            <ownedComment xmi:type="uml:Comment" xmi:id="id_g141" annotatedElement="id_2957">
              <body>Indica el número o nombre del tipo de vía.</body>
            </ownedComment>
            <ownedComment xmi:type="uml:Comment" xmi:id="id_g142" annotatedElement="id_2957">
              <body>[INTERLIS] Tipo Texto de longitud máxima 100</body>
            </ownedComment>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="id_2958" name="Geometria" type="id_885">
            <lowerValue xmi:type="uml:LiteralInteger" xmi:id="id_g143" value="1" />
            <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="id_g144" value="1" />
            <ownedComment xmi:type="uml:Comment" xmi:id="id_g145" annotatedElement="id_2958">
              <body>Geometría de tipo línea que corresponde a la representación espacial de la vía.</body>
            </ownedComment>
